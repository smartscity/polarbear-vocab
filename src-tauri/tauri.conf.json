{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polarbear Vocab",
  "version": "0.1.0",
  "identifier": "com.polarbear.vocab",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../app-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polarbear Vocab",
        "width": 980,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://storage.googleapis.com; img-src 'self' asset: http://asset.localhost data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/generated/content.db": "content.db"
    }
  }
}

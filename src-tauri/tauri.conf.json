{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polarbear Vocab",
  "version": "0.1.0",
  "identifier": "com.polarbear.vocab",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../app-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polarbear Vocab",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../data/generated/content.db": "content.db"
    }
  }
}
